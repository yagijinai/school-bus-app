# ==============================================================================
# スクールバス運行管理システム：環境変数テンプレート
#
# 【ローカル開発時】
# 本ファイルをコピーして「.env.local」を作成し、実際のSupabase接続情報を設定してください。
#   cp .env.example .env.local
#
# 【Vercel / Cloudflare Pages / Netlify 等のデプロイ時】
# ホスティングサービスの「Environment Variables」管理画面にて以下の2つを登録してください。
# ==============================================================================

# Supabase Project URL (Supabase管理画面 Project Settings > API > Project URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Key (Supabase管理画面 Project Settings > API > Project API keys > anon public)
VITE_SUPABASE_ANON_KEY=your-anon-key-here
